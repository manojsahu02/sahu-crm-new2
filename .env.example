# ---- Database (docker-compose service name "mongo") ----
MONGO_URL=mongodb://mongo:27017
DB_NAME=sahu_crm

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS (comma separated, use your real domain in production) ----
CORS_ORIGINS=https://crm.indorejyotish.in

# ---- AI Receptionist (Google Gemini) ----
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Razorpay (Auto Pay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Nextel (WhatsApp / calling automation) ----
NEXTEL_AUDIENCE_URL=
NEXTEL_BEARER_TOKEN=

# ---- Google Sheets sync (optional) ----
GOOGLE_SHEET_CSV_URL=
SHEETS_SYNC_INTERVAL_SECONDS=300

# ---- File uploads (Cloudflare R2 - free tier) ----
MAX_UPLOAD_SIZE_MB=10
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sahu-crm-uploads
